APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 接骨院の情報（メール本文などに表示する）
CLINIC_NAME=さくら接骨院
CLINIC_PHONE=000-000-0000

MAIL_MAILER=log
# 開発中は送信せず storage/logs/mail.log に書き出す
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${CLINIC_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 患者側の画面（Next.js）の URL。予約管理ページのリンクに使う
FRONTEND_URL=http://localhost:3000

# 管理画面（ログインに Cookie を使う画面）の場所。ここに書いたサイトからのリクエストにだけ、セッションと CSRF 対策を付ける
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

# 画面側（Next.js）との合言葉。frontend の CLINIC_PROXY_SECRET と同じ値にする（長いランダムな文字列）。
# 正しい合言葉つきで転送されたリクエストだけ、患者の IP アドレスを回数制限に使う。空なら使わない
CLINIC_PROXY_SECRET=
