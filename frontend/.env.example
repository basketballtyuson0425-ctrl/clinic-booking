# Laravel（バックエンド）の URL。/api と /sanctum へのアクセスをここへ転送する（ブラウザには公開しない）
BACKEND_URL=http://127.0.0.1:8000

# 画面に表示する接骨院の名前と電話番号（ビルド時にブラウザ用のプログラムへ埋め込まれる）
NEXT_PUBLIC_CLINIC_NAME=さくら接骨院
NEXT_PUBLIC_CLINIC_PHONE=000-000-0000

# Laravel との合言葉（backend/.env の CLINIC_PROXY_SECRET と同じ値）。Vercel の上で動かすときだけ、
# 患者の IP アドレスをこの合言葉つきで Laravel に渡す（src/proxy.ts）。ブラウザには渡らない（NEXT_PUBLIC_ を付けない）
CLINIC_PROXY_SECRET=
